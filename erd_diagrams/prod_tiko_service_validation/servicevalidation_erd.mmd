    offers_services ||--o{ services : "service_id → id (offers_services_service_id_fkey)"
    provider_based_restrictions ||--o{ locations_structure : "location_id → id (provider_based_restrictions_location_id_fkey)"
    question_countries ||--o{ questions : "question_id → id (question_countries_question_id_fkey)"
    question_services ||--o{ questions : "question_id → id (question_services_question_id_fkey)"
    question_services ||--o{ services : "service_id → id (question_services_service_id_fkey)"
    screening_score_history ||--o{ service_validated_history : "service_validated_history_id → id (screening_score_history_service_validated_history_id_fkey)"
    screenings_in_progress ||--o{ clients : "client_id → id (screenings_in_progress_client_id_fkey)"
    screenings_in_progress ||--o{ services : "service_id → id (screenings_in_progress_service_id_fkey)"
    service_compliance_facility_designations ||--o{ service_compliance_restrictions : "service_compliance_restriction_id → id (service_compliance_facility_d_service_compliance_restricti_fkey)"
    service_compliance_restrictions ||--o{ locations_structure : "location_id → id (service_compliance_restrictions_location_id_fkey)"
    service_compliance_restrictions ||--o{ services : "service_id → id (service_compliance_restrictions_service_id_fkey)"
    service_flow_arrows ||--o{ service_flow_nodes : "source_node_id → id (service_flow_arrows_source_node_id_fkey)"
    service_flow_arrows ||--o{ service_flow_nodes : "target_node_id → id (service_flow_arrows_target_node_id_fkey)"
    service_flow_arrows ||--o{ service_flows : "service_flow_id → id (service_flow_arrows_service_flow_id_fkey)"
    service_flow_nodes ||--o{ service_flows : "service_flow_id → id (service_flow_nodes_service_flow_id_fkey)"
    service_flow_nodes ||--o{ services : "service_id → id (service_flow_nodes_service_id_fkey)"
