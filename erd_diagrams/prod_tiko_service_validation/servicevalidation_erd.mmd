    facility_interventions ||--o{ interventions : "intervention_id → id (facility_interventions_intervention_id_fkey)"
    offers ||--o{ interventions : "intervention_id → id (offers_intervention_id_fkey)"
    offers ||--o{ projects : "project_id → id (offers_project_id_fkey)"
