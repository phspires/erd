    service_flow_states ||--o{ exclusion_groups : "exclusion_group_id → id (service_flow_states_exclusion_group_id_fkey)"
    service_flow_states ||--o{ service_flow_nodes : "service_flow_node_id → id (service_flow_states_service_flow_node_id_fkey)"
    service_flow_states ||--o{ service_validated_history : "last_service_validated_id → id (service_flow_states_last_service_validated_id_fkey)"
    service_flows ||--o{ exclusion_groups : "exclusion_group_id → id (service_flows_exclusion_group_id_fkey)"
    service_flows ||--o{ interventions : "intervention_id → id (service_flows_intervention_id_fkey)"
    service_validated_history ||--o{ clients : "client_id → id (service_validated_history_client_id_fkey)"
    service_validated_history ||--o{ facilities : "facility_id → id (service_validated_history_facility_id_fkey)"
    service_validated_history ||--o{ services : "service_id → id (service_validated_history_service_id_fkey)"
    services ||--o{ interventions : "intervention_id → id (services_intervention_id_fkey)"